{
  "extends": "./node_modules/@microsoft/rush-stack-compiler-4.7/includes/tsconfig-web.json",
  "compilerOptions": {
    /* ---- Modern target & module settings ---- */
    "target": "es2017",                         /* supports .includes(), async/await, etc. */
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react",

    /* ---- Build options ---- */
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "outDir": "lib",
    "inlineSources": false,

    /* ---- Type roots ---- */
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@microsoft"
    ],
    "types": [
      "webpack-env"
    ],

    /* ---- Libraries included ---- */
    "lib": [
      "dom",
      "es2015",
      "es2016",
      "es2017",
      "scripthost"
    ]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
