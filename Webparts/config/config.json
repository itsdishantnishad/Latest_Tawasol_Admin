{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "news-story-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/newsStory/NewsStoryWebPart.js",
          "manifest": "./src/webparts/newsStory/NewsStoryWebPart.manifest.json"
        }
      ]
    },
    "feature-wheel-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/featureWheel/FeatureWheelWebPart.js",
          "manifest": "./src/webparts/featureWheel/FeatureWheelWebPart.manifest.json"
        }
      ]
    },
    "banner-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/banner/BannerWebPart.js",
          "manifest": "./src/webparts/banner/BannerWebPart.manifest.json"
        }
      ]
    },
    "news-page-title-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/newsPageTitle/NewsPageTitleWebPart.js",
          "manifest": "./src/webparts/newsPageTitle/NewsPageTitleWebPart.manifest.json"
        }
      ]
    },
    "more-for-you-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/moreForYou/MoreForYouWebPart.js",
          "manifest": "./src/webparts/moreForYou/MoreForYouWebPart.manifest.json"
        }
      ]
    },
    "team-organisation-structure-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/teamOrganisationStructure/TeamOrganisationStructureWebPart.js",
          "manifest": "./src/webparts/teamOrganisationStructure/TeamOrganisationStructureWebPart.manifest.json"
        }
      ]
    },
    "lets-celebrate-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/letsCelebrate/LetsCelebrateWebPart.js",
          "manifest": "./src/webparts/letsCelebrate/LetsCelebrateWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "NewsStoryWebPartStrings": "lib/webparts/newsStory/loc/{locale}.js",
    "FeatureWheelWebPartStrings": "lib/webparts/featureWheel/loc/{locale}.js",
    "BannerWebPartStrings": "lib/webparts/banner/loc/{locale}.js",
    "NewsPageTitleWebPartStrings": "lib/webparts/newsPageTitle/loc/{locale}.js",
    "MoreForYouWebPartStrings": "lib/webparts/moreForYou/loc/{locale}.js",
    "TeamOrganisationStructureWebPartStrings": "lib/webparts/teamOrganisationStructure/loc/{locale}.js",
    "LetsCelebrateWebPartStrings": "lib/webparts/letsCelebrate/loc/{locale}.js"
  }
}
